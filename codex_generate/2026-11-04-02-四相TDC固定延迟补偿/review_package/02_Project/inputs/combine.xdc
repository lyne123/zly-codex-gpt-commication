# FPGA-TDC v3: tdc_fine_layer.v, CARRY_NUM=16, xc7k325tffg900-2.
# Instance prefix: u_tdc_fine_layer. Use ONLY in implementation, PROCESSING_ORDER=LATE.
# Four independent 64-tap TDLs: X4/X6/X8/X10, Y60..Y75.
# CO[0..3] sampling FFs share the CARRY4 Slice at AFF/BFF/CFF/DFF.
# Decoder and related-phase transfer registers are placed by Vivado.
# No timing exceptions or clock definitions are added by this file.
# Board inputs: AD12/SSTL135, C22/LVCMOS18, AD23/LVCMOS18 (same as v2).
create_clock -period 10.000 -name sys_clk -waveform {0.000 5.000} [get_ports sys_clk]
set_property PACKAGE_PIN AD12 [get_ports sys_clk]
set_property IOSTANDARD SSTL135 [get_ports sys_clk]

# -- bank13����1
set_property PACKAGE_PIN C22 [get_ports sys_rst_n]
set_property IOSTANDARD LVCMOS18 [get_ports sys_rst_n]


# 1. ����PWM�ź�pwm_in���������ã�����Ƿ�ΪMRCC��SRCC
# bank12��ad23���ţ�1.8v��ƽ
set_property PACKAGE_PIN AF20 [get_ports pwm_in]
set_property IOSTANDARD LVCMOS18 [get_ports pwm_in]

# Phase 0 degrees: u_tdl0.
set_property -dict {LOC SLICE_X26Y4 BEL CARRY4 DONT_TOUCH 1} [get_cells {u_tdc_fine_layer/u_tdl0/g_carry[0].u_carry4}]
set_property BEL AFF [get_cells {u_tdc_fine_layer/u_tdl0/thermo_q_reg[0]}]
set_property -dict {LOC SLICE_X26Y4 BEL AFF DONT_TOUCH 1} [get_cells {u_tdc_fine_layer/u_tdl0/thermo_q_reg[0]}]
