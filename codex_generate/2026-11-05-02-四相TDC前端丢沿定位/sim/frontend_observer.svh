function automatic integer in_window(input time t);
in_window = (t>=238600000 && t<=238900000) || (t>=241900000 && t<=242200000) || (t>=245200000 && t<=245500000);
endfunction
initial begin
wait(output_dir!="");
observer_fd=$fopen({output_dir,"/frontend_signals.csv"},"w");
$fdisplay(observer_fd,"time_ps,local_time_ps,p0_thermo,p0_carry,p0_detected_type,p0_code_raw,p0_raw_edge_type,p0_code_in_range,p0_encoder_ready,p0_code_q,p0_edge_type_d,p0_edge_type_q,p0_output_ready,p90_thermo,p90_carry,p90_detected_type,p90_code_raw,p90_raw_edge_type,p90_code_in_range,p90_encoder_ready,p90_code_q,p90_edge_type_d,p90_edge_type_q,p90_output_ready,p180_thermo,p180_carry,p180_detected_type,p180_code_raw,p180_raw_edge_type,p180_code_in_range,p180_encoder_ready,p180_code_q,p180_edge_type_d,p180_edge_type_q,p180_output_ready,p270_thermo,p270_carry,p270_detected_type,p270_code_raw,p270_raw_edge_type,p270_code_in_range,p270_encoder_ready,p270_code_q,p270_edge_type_d,p270_edge_type_q,p270_output_ready,pwm_meta,pwm_sync,pwm_history,frame_ready,aux_up,pwm_meta_D,pwm_meta_C,pwm_meta_D_dly,pwm_meta_C_dly,pwm_meta_Q,pwm_sync_D,pwm_sync_C,pwm_sync_D_dly,pwm_sync_C_dly,pwm_sync_Q,pwm_history_D,pwm_history_C,pwm_history_D_dly,pwm_history_C_dly,pwm_history_Q,aux_rise,aux_rise_pipe,aux_rise_match,aux_fall,aux_fall_pipe,aux_fall_match,pack0_d1,pack90_d2,pack180_d1,pack270_to90,final_type90,final_type180,final_type270,final_type0,sync_edge_valid,sync_edge_polarity,sync_valid");
capture_fd=$fopen({output_dir,"/aux_capture.csv"},"w");
$fdisplay(capture_fd,"time_ps,local_time_ps,stage,pin_D,effective_D,Q_before,pwm_in");
end
always @(negedge dut.clk_500m or negedge dut.clk_500m_deg90 or negedge dut.clk_500m_deg180 or negedge dut.clk_500m_deg270) begin
