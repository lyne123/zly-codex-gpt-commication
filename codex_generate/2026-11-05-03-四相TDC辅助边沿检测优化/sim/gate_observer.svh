wire [0:0] mon_p270_history=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[3].pwm_history_reg .Q;
wire [9:0] mon_pack0_d1={dut.u_tdc_fine_layer.\pack0_d1_reg[9] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[8] .Q,1'b0,dut.u_tdc_fine_layer.\pack0_d1_reg[6] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[5] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[4] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[3] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[2] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[1] .Q,dut.u_tdc_fine_layer.\pack0_d1_reg[0] .Q};
wire [9:0] mon_pack90_d2={dut.u_tdc_fine_layer.\pack90_d2_reg[9] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[8] .Q,1'b0,dut.u_tdc_fine_layer.\pack90_d2_reg[6] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[5] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[4] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[3] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[2] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[1] .Q,dut.u_tdc_fine_layer.\pack90_d2_reg[0] .Q};
wire [9:0] mon_pack180_d1={dut.u_tdc_fine_layer.\pack180_d1_reg[9] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[8] .Q,1'b0,dut.u_tdc_fine_layer.\pack180_d1_reg[6] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[5] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[4] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[3] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[2] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[1] .Q,dut.u_tdc_fine_layer.\pack180_d1_reg[0] .Q};
wire [9:0] mon_pack270_to90={dut.u_tdc_fine_layer.\pack270_to90_reg[9] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[8] .Q,1'b0,dut.u_tdc_fine_layer.\pack270_to90_reg[6] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[5] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[4] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[3] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[2] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[1] .Q,dut.u_tdc_fine_layer.\pack270_to90_reg[0] .Q};
wire [7:0] mon_confirmed_type_D={dut.u_tdc_fine_layer.\sync_edge_polarity_reg[7] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[6] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[5] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[4] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[3] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[2] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[1] .D,dut.u_tdc_fine_layer.\sync_edge_polarity_reg[0] .D};
wire [3:0] mon_raw_mask=dut.sync_edge_valid;
wire [7:0] mon_raw_polarity=dut.sync_edge_polarity;
function automatic integer in_window(input time t); in_window=(t>=238600000 && t<=238900000) || (t>=241900000 && t<=242200000) || (t>=245200000 && t<=245500000); endfunction
initial begin #1;
gate_aux_fd=$fopen({output_dir,"/aux_events.csv"},"w");
gate_window_fd=$fopen({output_dir,"/aux_windows.csv"},"w");
gate_capture_fd=$fopen({output_dir,"/meta_capture.csv"},"w");
gate_change_fd=$fopen({output_dir,"/meta_changes.csv"},"w");
$fdisplay(gate_capture_fd,"time_ps,local_time_ps,phase,D,D_dly,Q_before,pwm_in");
$fdisplay(gate_change_fd,"time_ps,local_time_ps,signal,value");
$fdisplay(gate_aux_fd,"time_ps,local_time_ps,rise_slots,fall_slots,rise_claim_3_1,fall_claim_3_1,p0_meta,p0_D,p0_C,p0_D_dly,p0_C_dly,p0_sync,p0_history,p90_meta,p90_D,p90_C,p90_D_dly,p90_C_dly,p90_sync,p90_history,p180_meta,p180_D,p180_C,p180_D_dly,p180_C_dly,p180_sync,p180_history,p270_meta,p270_D,p270_C,p270_D_dly,p270_C_dly,p270_sync,p270_history,pack0_d1,pack90_d2,pack180_d1,pack270_to90,confirmed_type_D,raw_mask,raw_polarity");
$fdisplay(gate_window_fd,"time_ps,local_time_ps,rise_slots,fall_slots,rise_claim_3_1,fall_claim_3_1,p0_meta,p0_D,p0_C,p0_D_dly,p0_C_dly,p0_sync,p0_history,p90_meta,p90_D,p90_C,p90_D_dly,p90_C_dly,p90_sync,p90_history,p180_meta,p180_D,p180_C,p180_D_dly,p180_C_dly,p180_sync,p180_history,p270_meta,p270_D,p270_C,p270_D_dly,p270_C_dly,p270_sync,p270_history,pack0_d1,pack90_d2,pack180_d1,pack270_to90,confirmed_type_D,raw_mask,raw_polarity");
end
always @(negedge dut.clk_500m) begin #1;
if($time>5000000 && gate_aux_fd) begin
if((|mon_rise_slots)||(|mon_fall_slots)||(|mon_raw_mask)) $fdisplay(gate_aux_fd,"%0t,%0t,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%h,%h,%h,%h,%0d,%0d,%0d",$time+time_shift,$time,mon_rise_slots,mon_fall_slots,mon_rise_claim_3_1,mon_fall_claim_3_1,mon_p0_meta,mon_p0_D,mon_p0_C,mon_p0_D_dly,mon_p0_C_dly,mon_p0_sync,mon_p0_history,mon_p90_meta,mon_p90_D,mon_p90_C,mon_p90_D_dly,mon_p90_C_dly,mon_p90_sync,mon_p90_history,mon_p180_meta,mon_p180_D,mon_p180_C,mon_p180_D_dly,mon_p180_C_dly,mon_p180_sync,mon_p180_history,mon_p270_meta,mon_p270_D,mon_p270_C,mon_p270_D_dly,mon_p270_C_dly,mon_p270_sync,mon_p270_history,mon_pack0_d1,mon_pack90_d2,mon_pack180_d1,mon_pack270_to90,mon_confirmed_type_D,mon_raw_mask,mon_raw_polarity);
if(in_window($time+time_shift)) $fdisplay(gate_window_fd,"%0t,%0t,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%0d,%h,%h,%h,%h,%0d,%0d,%0d",$time+time_shift,$time,mon_rise_slots,mon_fall_slots,mon_rise_claim_3_1,mon_fall_claim_3_1,mon_p0_meta,mon_p0_D,mon_p0_C,mon_p0_D_dly,mon_p0_C_dly,mon_p0_sync,mon_p0_history,mon_p90_meta,mon_p90_D,mon_p90_C,mon_p90_D_dly,mon_p90_C_dly,mon_p90_sync,mon_p90_history,mon_p180_meta,mon_p180_D,mon_p180_C,mon_p180_D_dly,mon_p180_C_dly,mon_p180_sync,mon_p180_history,mon_p270_meta,mon_p270_D,mon_p270_C,mon_p270_D_dly,mon_p270_C_dly,mon_p270_sync,mon_p270_history,mon_pack0_d1,mon_pack90_d2,mon_pack180_d1,mon_pack270_to90,mon_confirmed_type_D,mon_raw_mask,mon_raw_polarity);
end end
always @(posedge mon_p0_C_dly) if(gate_capture_fd && in_window($time+time_shift)) $fdisplay(gate_capture_fd,"%0t,%0t,0,%0d,%0d,%0d,%0d",$time+time_shift,$time,mon_p0_D,mon_p0_D_dly,mon_p0_meta,pwm_in);
always @(mon_p0_D) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_D,%0d",$time+time_shift,$time,mon_p0_D);
always @(mon_p0_D_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_D_dly,%0d",$time+time_shift,$time,mon_p0_D_dly);
always @(mon_p0_C_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_C_dly,%0d",$time+time_shift,$time,mon_p0_C_dly);
always @(mon_p0_meta) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_meta,%0d",$time+time_shift,$time,mon_p0_meta);
always @(mon_p0_sync) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_sync,%0d",$time+time_shift,$time,mon_p0_sync);
always @(mon_p0_history) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p0_history,%0d",$time+time_shift,$time,mon_p0_history);
always @(posedge mon_p90_C_dly) if(gate_capture_fd && in_window($time+time_shift)) $fdisplay(gate_capture_fd,"%0t,%0t,90,%0d,%0d,%0d,%0d",$time+time_shift,$time,mon_p90_D,mon_p90_D_dly,mon_p90_meta,pwm_in);
always @(mon_p90_D) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_D,%0d",$time+time_shift,$time,mon_p90_D);
always @(mon_p90_D_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_D_dly,%0d",$time+time_shift,$time,mon_p90_D_dly);
always @(mon_p90_C_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_C_dly,%0d",$time+time_shift,$time,mon_p90_C_dly);
always @(mon_p90_meta) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_meta,%0d",$time+time_shift,$time,mon_p90_meta);
always @(mon_p90_sync) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_sync,%0d",$time+time_shift,$time,mon_p90_sync);
always @(mon_p90_history) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p90_history,%0d",$time+time_shift,$time,mon_p90_history);
always @(posedge mon_p180_C_dly) if(gate_capture_fd && in_window($time+time_shift)) $fdisplay(gate_capture_fd,"%0t,%0t,180,%0d,%0d,%0d,%0d",$time+time_shift,$time,mon_p180_D,mon_p180_D_dly,mon_p180_meta,pwm_in);
always @(mon_p180_D) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_D,%0d",$time+time_shift,$time,mon_p180_D);
always @(mon_p180_D_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_D_dly,%0d",$time+time_shift,$time,mon_p180_D_dly);
always @(mon_p180_C_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_C_dly,%0d",$time+time_shift,$time,mon_p180_C_dly);
always @(mon_p180_meta) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_meta,%0d",$time+time_shift,$time,mon_p180_meta);
always @(mon_p180_sync) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_sync,%0d",$time+time_shift,$time,mon_p180_sync);
always @(mon_p180_history) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p180_history,%0d",$time+time_shift,$time,mon_p180_history);
always @(posedge mon_p270_C_dly) if(gate_capture_fd && in_window($time+time_shift)) $fdisplay(gate_capture_fd,"%0t,%0t,270,%0d,%0d,%0d,%0d",$time+time_shift,$time,mon_p270_D,mon_p270_D_dly,mon_p270_meta,pwm_in);
always @(mon_p270_D) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_D,%0d",$time+time_shift,$time,mon_p270_D);
always @(mon_p270_D_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_D_dly,%0d",$time+time_shift,$time,mon_p270_D_dly);
always @(mon_p270_C_dly) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_C_dly,%0d",$time+time_shift,$time,mon_p270_C_dly);
always @(mon_p270_meta) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_meta,%0d",$time+time_shift,$time,mon_p270_meta);
always @(mon_p270_sync) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_sync,%0d",$time+time_shift,$time,mon_p270_sync);
always @(mon_p270_history) if(gate_change_fd && in_window($time+time_shift)) $fstrobe(gate_change_fd,"%0t,%0t,p270_history,%0d",$time+time_shift,$time,mon_p270_history);
