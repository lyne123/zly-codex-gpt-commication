wire [0:0] mon_p90_history=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[1].pwm_history_reg .Q;
wire [0:0] mon_p180_meta=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_meta_reg .Q;
wire [0:0] mon_p180_D=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_meta_reg .D;
wire [0:0] mon_p180_C=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_meta_reg .C;
wire [0:0] mon_p180_D_dly=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_meta_reg .D_dly;
wire [0:0] mon_p180_C_dly=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_meta_reg .C_dly;
wire [0:0] mon_p180_sync=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_sync_reg .Q;
wire [0:0] mon_p180_history=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[2].pwm_history_reg .Q;
