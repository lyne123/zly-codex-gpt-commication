integer gate_aux_fd,gate_window_fd,gate_capture_fd,gate_change_fd;
wire [3:0] mon_rise_slots={dut.u_tdc_fine_layer.\g_aux_4phase.aux_rise_slots_reg[3] .Q,dut.u_tdc_fine_layer.\g_aux_4phase.aux_rise_slots_reg[2] .Q,dut.u_tdc_fine_layer.\g_aux_4phase.aux_rise_slots_reg[1] .Q,dut.u_tdc_fine_layer.\g_aux_4phase.aux_rise_slots_reg[0] .Q};
