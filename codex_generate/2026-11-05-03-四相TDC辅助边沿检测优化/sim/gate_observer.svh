wire [0:0] mon_p90_C=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[1].pwm_meta_reg .C;
wire [0:0] mon_p90_D_dly=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[1].pwm_meta_reg .D_dly;
wire [0:0] mon_p90_C_dly=dut.u_tdc_fine_layer.\g_aux_4phase.g_phase[1].pwm_meta_reg .C_dly;
